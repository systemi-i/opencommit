{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igsl.dev/icsl/schemas/0.1-freeze/GateConfig.schema.json",
  "title": "GateConfig",
  "type": "object",
  "properties": {
    "authority": { "$ref": "ICSLCommon.schema.json#/$defs/AuthorityGate" },
    "evidence": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "attested_absence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "commitment_point": { "type": "string" }
            },
            "required": ["commitment_point"],
            "additionalProperties": false
          }
        },
        "notes": { "type": "string" }
      },
      "required": ["required"],
      "additionalProperties": false
    },
    "reasoning": {
      "type": "object",
      "properties": {
        "rule": { "type": "string" },
        "reference": { "type": "string" },
        "mode": {
          "type": "string",
          "description": "Reasoning mode (enum included in the v0.1 candidate). Where the underlying law confers discretion, use guided_discretion or open_discretion; do not convert discretion into a deterministic rule.",
          "enum": [
            "deterministic_rule",
            "calculation",
            "guided_discretion",
            "open_discretion",
            "ai_assisted",
            "external_judgment",
            "mixed"
          ]
        },
        "notes": { "type": "string" }
      },
      "anyOf": [
        { "required": ["rule"] },
        { "required": ["reference"] }
      ],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "requires": {
          "type": "array",
          "items": { "$ref": "ICSLCommon.schema.json#/$defs/DependencyExpression" }
        }
      },
      "required": ["requires"],
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "properties": {
        "protocol_version_id": { "type": "string" },
        "references": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["protocol_version_id"],
      "additionalProperties": false
    },
    "recourse": { "$ref": "ICSLCommon.schema.json#/$defs/RecourseGate" }
  },
  "required": ["authority", "evidence", "reasoning", "dependency", "version", "recourse"],
  "additionalProperties": false
}
