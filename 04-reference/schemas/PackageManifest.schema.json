{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igsl.dev/icsl/schemas/0.1-freeze/PackageManifest.schema.json",
  "title": "PackageManifest",
  "type": "object",
  "properties": {
    "kind": { "const": "PackageManifest" },
    "package_id": { "type": "string" },
    "icsl_version": { "type": "string" },
    "profile": { "$ref": "ICSLCommon.schema.json#/$defs/ConformanceClass" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "role": {
            "type": "string",
            "enum": [
              "manifest",
              "protocol-version",
              "conformance-declaration",
              "hash-vector",
              "reference",
              "receipt",
              "rendering",
              "extension",
              "execution-binding"
            ]
          }
        },
        "required": ["path", "role"]
      }
    },
    "publisher": {
      "type": "object",
      "description": "Optional declaration of who published this encoding and their relationship to the institution (added in the 2026-07 repair sprint — see 07-decisions/). SHOULD at Core-L2. An encoding confers no independent legal effect; the underlying source prevails.",
      "properties": {
        "name": { "type": "string" },
        "relationship": {
          "type": "string",
          "enum": [
            "authoritative_self_published",
            "delegated_publisher",
            "third_party_unofficial"
          ]
        }
      },
      "required": ["name", "relationship"],
      "additionalProperties": false
    }
  },
  "required": ["kind", "package_id", "icsl_version", "profile", "files"],
  "additionalProperties": true
}
