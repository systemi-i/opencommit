{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igsl.dev/icsl/schemas/0.1-freeze/Receipt.schema.json",
  "title": "Receipt",
  "type": "object",
  "properties": {
    "receipt_id": { "type": "string" },
    "receipt_hash": { "type": "string" },
    "previous_hash": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "content_hash": { "type": "string" },
    "content": { "type": "object" },
    "created_at": { "type": "string" }
  },
  "required": ["receipt_id", "receipt_hash", "previous_hash"],
  "additionalProperties": true
}
