{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igsl.dev/icsl/schemas/0.1-freeze/ProtocolVersion.schema.json",
  "title": "ProtocolVersion",
  "type": "object",
  "properties": {
    "kind": { "const": "ProtocolVersion" },
    "protocol_version_id": { "type": "string" },
    "icsl_version": { "type": "string" },
    "encoding_depth": {
      "type": "string",
      "enum": ["L1", "L2", "L3"]
    },
    "conformance_class": { "$ref": "ICSLCommon.schema.json#/$defs/ConformanceClass" },
    "governed_context": { "type": "object" },
    "commitment_points": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "CommitmentPoint.schema.json" }
    }
  },
  "required": ["kind", "protocol_version_id", "icsl_version", "commitment_points"],
  "additionalProperties": true
}
