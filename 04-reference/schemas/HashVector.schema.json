{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igsl.dev/icsl/schemas/0.1-freeze/HashVector.schema.json",
  "title": "HashVector",
  "description": "Package hash vector: source-byte hashes for every file, plus canonical-JSON (RFC 8785 JCS) hashes for JSON artifacts (ADR-002 dual-hash decision).",
  "type": "object",
  "properties": {
    "kind": { "const": "HashVector" },
    "algorithm": { "const": "sha256" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "source_hash": { "$ref": "ICSLCommon.schema.json#/$defs/TaggedHash" },
          "canonical_hash": { "$ref": "ICSLCommon.schema.json#/$defs/TaggedHash" }
        },
        "required": ["path", "source_hash"],
        "additionalProperties": false
      }
    }
  },
  "required": ["kind", "algorithm", "entries"],
  "additionalProperties": true
}
